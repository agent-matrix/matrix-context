{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-matrix.org/moc/v1/pack_response.json",
  "title": "PackResponse",
  "type": "object",
  "properties": {
    "tokens": {
      "type": "integer"
    },
    "selected_experts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing_reason": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "expert": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "expert",
          "content"
        ]
      }
    }
  },
  "required": [
    "tokens",
    "selected_experts",
    "prompt",
    "items"
  ]
}
